node_modules
dist
dist-ssr
*.local

.DS_Store
.vscode/*
!.vscode/extensions.json
.idea

# Copied out of node_modules by scripts/copy-rive-wasm.mjs on dev/build.
public/rive.wasm

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Project and source files never belong in git.
*.prproj
*.aep
/masters

# Video is served from Cloudflare R2, not committed. Git keeps every version of
# every file permanently, so committing a reel you'll re-cut bloats the repo
# forever. Poster images are deliberately NOT ignored — they're small enough
# that keeping their history is harmless.
public/video/*.mp4
public/video/*.mov
public/video/*.m4v
public/video/*.webm
